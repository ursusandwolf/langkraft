CREATE TABLE IF NOT EXISTS Content (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    audioUrl TEXT NOT NULL,
    localAudioPath TEXT,
    sourceUrl TEXT NOT NULL,
    durationSeconds INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS SubtitleLine (
    id TEXT NOT NULL PRIMARY KEY,
    contentId TEXT NOT NULL,
    startMs INTEGER NOT NULL,
    endMs INTEGER NOT NULL,
    textDe TEXT NOT NULL,
    textEn TEXT,
    FOREIGN KEY (contentId) REFERENCES Content(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS subtitle_content_time ON SubtitleLine(contentId, startMs);
CREATE TABLE IF NOT EXISTS Vocabulary (
    id TEXT NOT NULL PRIMARY KEY,
    word TEXT NOT NULL,
    lemma TEXT,
    translation TEXT,
    contextSentence TEXT NOT NULL,
    contentId TEXT,
    subtitleLineId TEXT,
    addedAt INTEGER NOT NULL,
    nextReviewAt INTEGER,
    intervalDays INTEGER NOT NULL DEFAULT 0,
    easeFactor REAL NOT NULL DEFAULT 2.5,
    status TEXT NOT NULL DEFAULT 'NEW',
    FOREIGN KEY (contentId) REFERENCES Content(id) ON DELETE SET NULL,
    FOREIGN KEY (subtitleLineId) REFERENCES SubtitleLine(id) ON DELETE SET NULL
);
CREATE INDEX IF NOT EXISTS vocabulary_review ON Vocabulary(status, nextReviewAt);

selectAllContent:
SELECT * FROM Content ORDER BY createdAt DESC;

selectContent:
SELECT * FROM Content WHERE id = ?;

insertContent:
INSERT OR IGNORE INTO Content(id, title, audioUrl, localAudioPath, sourceUrl, durationSeconds, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateContent:
UPDATE Content SET title = ?, audioUrl = ?, localAudioPath = ?, sourceUrl = ?, durationSeconds = ? WHERE id = ?;

selectSubtitlesForContent:
SELECT * FROM SubtitleLine WHERE contentId = ? ORDER BY startMs ASC;

insertSubtitleLine:
INSERT OR IGNORE INTO SubtitleLine(id, contentId, startMs, endMs, textDe, textEn) VALUES (?, ?, ?, ?, ?, ?);

updateSubtitleLine:
UPDATE SubtitleLine SET startMs = ?, endMs = ?, textDe = ?, textEn = ? WHERE id = ? AND contentId = ?;

deleteSubtitleLine:
DELETE FROM SubtitleLine WHERE id = ?;

insertWord:
INSERT OR IGNORE INTO Vocabulary(id, word, lemma, translation, contextSentence, contentId, subtitleLineId, addedAt, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateWord:
UPDATE Vocabulary SET word = ?, lemma = ?, translation = ?, contextSentence = ?, contentId = ?, subtitleLineId = ?, status = ? WHERE id = ?;

selectVocabularyToReview:
SELECT * FROM Vocabulary WHERE status != 'MASTERED' AND (nextReviewAt <= ? OR nextReviewAt IS NULL) ORDER BY nextReviewAt ASC;

selectWord:
SELECT * FROM Vocabulary WHERE id = ?;

deleteWord:
DELETE FROM Vocabulary WHERE id = ?;

updateReviewSchedule:
UPDATE Vocabulary SET nextReviewAt = ?, intervalDays = ?, easeFactor = ? WHERE id = ?;
