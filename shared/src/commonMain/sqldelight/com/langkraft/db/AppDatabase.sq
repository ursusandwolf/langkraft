-- Table for storing media content (YouTube videos, audio files)
CREATE TABLE Content (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    audioUrl TEXT NOT NULL,         -- Remote URL
    localAudioPath TEXT,            -- Local path for offline mode
    sourceUrl TEXT NOT NULL,        -- Original YouTube URL
    durationSeconds INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL      -- Timestamp
);

-- Table for subtitle lines/cues
CREATE TABLE SubtitleLine (
    id TEXT NOT NULL PRIMARY KEY,
    contentId TEXT NOT NULL,
    startMs INTEGER NOT NULL,
    endMs INTEGER NOT NULL,
    textDe TEXT NOT NULL,           -- Original German text
    textEn TEXT,                    -- Optional English translation
    ordinal INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (contentId) REFERENCES Content(id) ON DELETE CASCADE
);

-- Table for vocabulary (saved words/phrases)
CREATE TABLE Vocabulary (
    id TEXT NOT NULL PRIMARY KEY,
    word TEXT NOT NULL,             -- The word itself (e.g., "Häuser")
    lemma TEXT,                     -- Dictionary form (e.g., "Haus")
    translation TEXT,               -- User or AI provided translation
    contextSentence TEXT,           -- The specific sentence where it was found
    contentId TEXT,                 -- Reference to source content
    subtitleLineId TEXT,            -- Reference to specific timestamp
    addedAt INTEGER NOT NULL,
    
    -- Spaced Repetition (SRS) data
    nextReviewAt INTEGER,           -- Timestamp for next review
    intervalDays INTEGER NOT NULL DEFAULT 0,
    easeFactor REAL NOT NULL DEFAULT 2.5,
    status TEXT NOT NULL DEFAULT 'NEW', -- NEW, LEARNING, MASTERED
    
    FOREIGN KEY (contentId) REFERENCES Content(id) ON DELETE SET NULL,
    FOREIGN KEY (subtitleLineId) REFERENCES SubtitleLine(id) ON DELETE SET NULL
);

-- Queries
selectAllContent:
SELECT * FROM Content ORDER BY createdAt DESC;

selectContentById:
SELECT * FROM Content WHERE id = ?;

selectLibrary:
SELECT Content.*, SubtitleLine.id AS subtitleId, SubtitleLine.startMs,
       SubtitleLine.endMs, SubtitleLine.textDe, SubtitleLine.textEn
FROM Content LEFT JOIN SubtitleLine ON Content.id = SubtitleLine.contentId
ORDER BY Content.createdAt DESC, Content.id, SubtitleLine.startMs, SubtitleLine.ordinal, SubtitleLine.id;

insertContent {
    UPDATE Content SET title = :title, audioUrl = :audioUrl,
        localAudioPath = :localAudioPath, sourceUrl = :sourceUrl,
        durationSeconds = :durationSeconds WHERE id = :id;
    INSERT OR IGNORE INTO Content(id, title, audioUrl, localAudioPath, sourceUrl, durationSeconds, createdAt)
    VALUES (:id, :title, :audioUrl, :localAudioPath, :sourceUrl, :durationSeconds, :createdAt);
}

selectSubtitlesForContent:
SELECT * FROM SubtitleLine WHERE contentId = ? ORDER BY startMs ASC, ordinal ASC, id ASC;

selectConflictingSubtitles:
SELECT id FROM SubtitleLine WHERE id IN :ids AND contentId != :contentId;

deleteObsoleteSubtitles:
DELETE FROM SubtitleLine WHERE contentId = :contentId AND id NOT IN :ids;

deleteSubtitlesForContent:
DELETE FROM SubtitleLine WHERE contentId = ?;

insertSubtitleLine {
    UPDATE SubtitleLine SET contentId = :contentId, startMs = :startMs,
        endMs = :endMs, textDe = :textDe, textEn = :textEn, ordinal = :ordinal WHERE id = :id;
    INSERT OR IGNORE INTO SubtitleLine(id, contentId, startMs, endMs, textDe, textEn, ordinal)
    VALUES (:id, :contentId, :startMs, :endMs, :textDe, :textEn, :ordinal);
}

upsertWord {
    UPDATE Vocabulary SET word = :word, lemma = :lemma, translation = :translation,
        contextSentence = :contextSentence, contentId = :contentId,
        subtitleLineId = :subtitleLineId, status = :status WHERE id = :id;
    INSERT OR IGNORE INTO Vocabulary(id, word, lemma, translation, contextSentence, contentId, subtitleLineId, addedAt, status)
    VALUES (:id, :word, :lemma, :translation, :contextSentence, :contentId, :subtitleLineId, :addedAt, :status);
}

selectVocabularyToReview:
SELECT * FROM Vocabulary WHERE nextReviewAt <= ? OR nextReviewAt IS NULL ORDER BY nextReviewAt ASC;

deleteWord:
DELETE FROM Vocabulary WHERE id = ?;
